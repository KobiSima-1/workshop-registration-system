<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level [%c{1}] %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- our code: info (creations) and warn (rejected operations) -->
        <Logger name="patmal.workshops.student.impl" level="info"/>
        <!-- third-party libraries: only warnings and errors -->
        <Root level="warn">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
