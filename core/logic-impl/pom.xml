<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>patmal.workshops.student.impl</groupId>
        <artifactId>core</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>logic-impl</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- our model implementation -->
        <dependency>
            <groupId>patmal.workshops.student.impl</groupId>
            <artifactId>model-impl</artifactId>
        </dependency>

        <!-- the logic API (model API is inherited from core) -->
        <dependency>
            <groupId>patmal.workshops</groupId>
            <artifactId>logic</artifactId>
        </dependency>

        <!-- logging: only the API is needed to compile; the implementation (log4j-core) is added in app at runtime -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <!-- e-mail validation -->
        <dependency>
            <groupId>commons-validator</groupId>
            <artifactId>commons-validator</artifactId>
        </dependency>

        <!-- JSON export -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- CSV import (bonus) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
        </dependency>
    </dependencies>
</project>
